{
  "name": "arham-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Arham Jewellers Customer AI Assistant",
  "type": "module",
  "bin": {
    "arham-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "start": "node --env-file=.env build/index.js",
    "start:http": "node --env-file=.env build/http-server.js",
    "agent": "node --env-file=.env build/agent-service.js",
    "dev": "tsc && node --env-file=.env build/index.js",
    "dev:http": "tsc && node --env-file=.env build/http-server.js",
    "dev:agent": "tsc && node --env-file=.env build/agent-service.js",
    "get-token": "tsc && node --env-file=.env build/get-token.js",
    "start:render": "node build/agent-service.js",
    "start:render": "node build/agent-service.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@openai/agents": "^0.11.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
